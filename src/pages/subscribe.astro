---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="Subscribe — Yariv Itzkovich"
  description="Subscribe to a short email when a new paper goes up. About one email every few months. Or follow via RSS."
>
  <section class="max-w-3xl mx-auto px-6 md:px-10 pt-32 pb-24">
    <div class="font-mono text-xs uppercase tracking-widest text-soft mb-4">Subscribe</div>
    <h1
      class="font-display leading-[0.95] mb-6"
      style="font-size: clamp(3rem, 8vw, 6rem); font-weight: 300"
    >
      Get the next paper.
    </h1>
    <p class="text-lg leading-relaxed text-muted mb-10 max-w-2xl">
      A short email when a new paper goes up — title, one-line summary, and a link.
      No newsletter, no marketing, no tracking pixels. About one email every few months.
    </p>

    <form id="subscribe-form" class="max-w-md">
      <label for="subscribe-email" class="block font-mono text-xs uppercase tracking-widest text-soft mb-3">
        Email address
      </label>
      {/* Stack input above button on phones so the row always fits the
          page width — the previous side-by-side layout was overflowing
          the right edge on narrow screens. From sm: up they sit side
          by side. min-w-0 on the input lets it shrink past its
          intrinsic width inside the flex container. */}
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          id="subscribe-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="flex-1 min-w-0 px-4 py-3 rounded-full border bg-transparent text-base outline-none focus:opacity-90 transition-opacity"
          style="border-color: var(--divider); color: var(--text)"
        />
        <button
          type="submit"
          class="px-5 py-3 rounded-full font-mono text-xs uppercase tracking-widest"
          style="background-color: var(--color-accent); color: var(--color-bg)"
        >
          Subscribe
        </button>
      </div>
      <p
        id="subscribe-message"
        class="mt-4 text-sm leading-relaxed"
        style="display: none"
        aria-live="polite"
      ></p>
    </form>

    {/* Follow-up CTA — shown only after a successful subscribe. Two
        side-by-side buttons mirroring the footer's Get-in-touch layout,
        so the visitor sees the same two channels in the same shape no
        matter where they encounter them. The standalone "Send a
        message" option was dropped along with the /contact page. */}
    <div id="subscribe-followup" class="mt-10 p-6 rounded-lg border" style="display: none; border-color: var(--divider); background-color: color-mix(in srgb, var(--surface) 60%, var(--text) 4%)">
      <div class="font-mono text-xs uppercase tracking-widest text-soft mb-2">While you're here</div>
      <p class="text-base leading-relaxed mb-5" style="color: var(--text)">
        Want to reach out personally too? Message me directly.
      </p>
      <div class="flex flex-nowrap gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-full text-sm border hover:opacity-70 transition-opacity flex-1"
          style="border-color: var(--divider); color: var(--text)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 5L2 7"/>
          </svg>
          Email
        </a>
        <a
          href="https://wa.me/972523975027"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-full text-sm border hover:opacity-70 transition-opacity flex-1"
          style="border-color: var(--divider); color: var(--text)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          WhatsApp
        </a>
      </div>
      <p class="text-xs text-soft mt-4">
        Or just close this — being subscribed is enough on its own.
      </p>
    </div>

    <div class="mt-16 pt-10 border-t" style="border-color: var(--divider)">
      <div class="font-mono text-xs uppercase tracking-widest text-soft mb-3">Or follow via RSS</div>
      <p class="text-muted leading-relaxed max-w-2xl mb-5">
        Use an RSS reader (Feedly, Inoreader, NetNewsWire, Zotero, etc.)? Copy this feed URL and paste it into your reader — that's all.
      </p>
      <button
        type="button"
        id="rss-copy-btn"
        class="flex items-center justify-between gap-4 w-full max-w-xl px-5 py-4 rounded-full border-2 hover:opacity-80 transition-opacity cursor-pointer text-left"
        style="border-color: var(--color-accent); color: var(--text)"
        aria-label="Copy RSS feed URL to clipboard"
        data-rss-url="https://yarivitzkovich.org/publications.xml"
      >
        <code class="font-mono text-xs sm:text-sm" style="overflow-x: auto; flex: 1; min-width: 0">https://yarivitzkovich.org/publications.xml</code>
        <span id="rss-copy-label" class="font-mono text-xs uppercase tracking-widest whitespace-nowrap shrink-0 inline-flex items-center gap-2 px-3 py-1.5 rounded-full" style="background-color: var(--color-accent); color: var(--color-bg)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          Copy
        </span>
      </button>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('rss-copy-btn');
        var label = document.getElementById('rss-copy-label');
        if (!btn || !label) return;
        var url = btn.getAttribute('data-rss-url') || '';
        var originalHtml = label.innerHTML;
        var resetTimer = null;

        function showCopied() {
          label.innerHTML =
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
            '<polyline points="20 6 9 17 4 12"></polyline></svg>Copied';
          // Keep the same pill styling (accent bg, bg-colored text);
          // just the icon + word change.
          if (resetTimer) clearTimeout(resetTimer);
          resetTimer = setTimeout(function () {
            label.innerHTML = originalHtml;
          }, 1800);
        }

        btn.addEventListener('click', function (e) {
          e.preventDefault();
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(showCopied, function () {
              // Fallback for environments without clipboard permission
              fallbackCopy();
            });
          } else {
            fallbackCopy();
          }
        });

        function fallbackCopy() {
          // Old-school select-and-execCommand fallback for legacy browsers
          // or insecure contexts (shouldn't happen on yarivitzkovich.org
          // since it's served over HTTPS, but kept for resilience).
          var ta = document.createElement('textarea');
          ta.value = url;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); showCopied(); } catch (_) {}
          document.body.removeChild(ta);
        }
      })();
    </script>

    <div class="mt-12 text-sm text-soft leading-relaxed max-w-2xl">
      <p>By subscribing, you'll receive a confirmation email to verify your address (double opt-in).
      Every notification email includes a one-click unsubscribe link.</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('subscribe-form');
      var msg = document.getElementById('subscribe-message');
      if (!form || !msg) return;

      var followup = document.getElementById('subscribe-followup');

      function show(text, isError) {
        msg.textContent = text;
        msg.style.display = 'block';
        msg.style.color = isError ? '#b3411c' : 'var(--text)';
      }

      function revealFollowup() {
        if (followup) followup.style.display = '';
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var emailInput = document.getElementById('subscribe-email');
        var email = (emailInput && emailInput.value || '').trim();
        if (!email) {
          show('Please enter an email address.', true);
          return;
        }

        show('Sending…', false);
        fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: email }),
        })
          .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
          .then(function (res) {
            if (res.status !== 200 || !res.body.ok) {
              if (res.body && res.body.error === 'invalid_email') {
                show("That doesn't look like a valid email address.", true);
              } else {
                show("Something went wrong. Please try again in a moment.", true);
              }
              return;
            }
            if (res.body.status === 'already_subscribed') {
              show("You're already subscribed — thanks!", false);
              revealFollowup();
              return;
            }
            // pending_confirmation
            if (res.body.email_send === 'failed') {
              show("You're on the list, but our confirmation email didn't go out. Please try again later or email Yariv directly.", true);
            } else {
              show("Check your inbox — we just sent you a confirmation link.", false);
              if (emailInput) emailInput.value = '';
              revealFollowup();
            }
          })
          .catch(function () {
            show("Couldn't reach the server. Please try again.", true);
          });
      });
    })();
  </script>
</BaseLayout>
