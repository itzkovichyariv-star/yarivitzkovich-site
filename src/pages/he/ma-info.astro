---
/**
 * Public landing page for the MA information session.
 *
 * Built to be pasted into an email and clicked by someone who has never
 * visited this site: everything above the fold answers "what, when, and how
 * do I get in", and the form is one screen below it. Registration is a single
 * step (no confirm-link round trip) because the confirmation email carrying
 * the Zoom link is itself the confirmation — see functions/api/event-register.js.
 *
 * All meeting facts come from src/data/event.js, which the API, the .ics
 * builder and the confirmation email import too. Nothing here is retyped.
 */
import LandingLayout from '../../layouts/LandingLayout.astro';
import { EVENT, eventSummary, googleCalendarUrl } from '../../data/event.js';

// Built at build time so the calendar button works with JavaScript off.
const gcalUrl = googleCalendarUrl();

// The three facts a reader needs before deciding, as a strip across the hero.
const facts = [
  { label: 'מועד', value: '8.9.2026', sub: 'יום שלישי' },
  { label: 'שעה', value: EVENT.timeLabel, sub: EVENT.timezoneNote },
  { label: 'איפה', value: 'בזום', sub: 'הקישור נשלח במייל' },
];

// What the hour actually contains. Numbered because a candidate scanning the
// page wants to know it is worth an evening, not to read a paragraph.
const agenda = [
  { n: '01', title: 'התכנית מקרוב', body: 'מבנה הלימודים, ההתמחות בייעוץ ארגוני וקהילתי, ומה בוגרת או בוגר של התכנית יודעים לעשות בסופה.' },
  { n: '02', title: 'היתרונות שבה', body: 'מה מייחד את התכנית הזו, ולמי היא מתאימה — כולל השילוב עם עבודה.' },
  { n: '03', title: 'שיחה פתוחה', body: 'מענה על שאלות. אפשר לשלוח שאלה מראש בטופס ההרשמה, ונתייחס אליה במפגש.' },
];

const shareText = `${eventSummary()} · ${EVENT.university}
${EVENT.dateLabel}, בשעה ${EVENT.timeLabel}
פרטים והרשמה: ${EVENT.pageUrl}`;

const pageTitle = `${EVENT.kicker} — ${EVENT.programme}`;
const pageDescription = `${EVENT.dateLabel}, בשעה ${EVENT.timeLabel}. ${EVENT.department}, ${EVENT.university}. הרשמה מראש, והקישור לזום נשלח במייל.`;
---
<LandingLayout
  title={`${pageTitle} — ${EVENT.university}`}
  description={pageDescription}
  ogImage="/images/ma-info-og.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'EducationEvent',
      name: eventSummary(),
      description: pageDescription,
      startDate: EVENT.startUtc,
      endDate: EVENT.endUtc,
      eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      inLanguage: 'he',
      location: { '@type': 'VirtualLocation', url: EVENT.pageUrl },
      organizer: { '@type': 'CollegeOrUniversity', name: EVENT.university, url: 'https://www.ariel.ac.il' },
      isAccessibleForFree: true,
      url: EVENT.pageUrl,
    })} />
  </Fragment>

  <!-- ───────── Hero ───────── -->
  <section class="hero">
    <!-- The grey diagonal wedge carrying the university mark, as it sits in
         Ariel's own campaign creative: anchored to the bottom-leading corner
         and clipped to a triangle. -->
    <div class="wedge" aria-hidden="true"></div>
    <img class="wedge-logo" src="/images/ariel-logo-navy.png" alt="אוניברסיטת אריאל בשומרון" width="736" height="424" />

    <div class="hero-inner">
      <div class="eyebrow">{EVENT.department}</div>

      <h1 class="display">
        מפגש זום פתוח<br>
        <span class="display-teal">תואר שני בייעוץ ארגוני וקהילתי</span>
      </h1>

      <p class="lede">
        נסביר על התכנית ועל היתרונות שבה, ונקיים שיחה פתוחה ומענה על שאלות.
      </p>

      <div class="facts">
        {facts.map((f) => (
          <div class="fact">
            <div class="fact-l">{f.label}</div>
            <div class="fact-v">{f.value}</div>
            <div class="fact-s">{f.sub}</div>
          </div>
        ))}
      </div>

      <div class="cta-row">
        <a href="#registration" class="btn-primary">להרשמה למפגש</a>
        <span class="cta-note">ההשתתפות ללא עלות · קישור הזום יישלח אליכם במייל</span>
      </div>

      <div class="tagline">
        אנחנו כאן בשביל העתיד <span class="tagline-teal">אתם כאן לקדם אותו</span>
      </div>
    </div>
  </section>

  <!-- ───────── The invitation, in their words ───────── -->
  <section class="light-band">
    <div class="wrap">
      <div class="marker">ההזמנה</div>
      <p class="greet">שלום רב,</p>
      <p class="body-lg">
        שמחים להזמינך למפגש זום בנושא תכנית לתואר שני במחלקה לסוציולוגיה ולאנתרופולוגיה,
        עם התמחות בייעוץ ארגוני וקהילתי.
      </p>
      <p class="body-md">
        זאת הזדמנות נוספת לקבל החלטה מושכלת, רגע לפני שמתחילה השנה החדשה.
      </p>

      <div class="hosts">
        <div class="host"><span class="host-badge">מ</span><span>{EVENT.hosts[0]}</span></div>
        <div class="host"><span class="host-badge">י</span><span>{EVENT.hosts[1]}</span></div>
      </div>

      <div class="marker marker-spaced">מה נעשה במפגש</div>
      <div class="agenda">
        {agenda.map((item) => (
          <div class="agenda-card">
            <div class="agenda-n">{item.n}</div>
            <div class="agenda-t">{item.title}</div>
            <p class="agenda-b">{item.body}</p>
          </div>
        ))}
      </div>

      <div class="marker marker-spaced">מתכונת הלימודים · {EVENT.academicYear}</div>
      <div class="days">
        <div class="day day-teal">
          <div class="day-letter">ג׳</div>
          <div>
            <div class="day-t">ימי שלישי</div>
            <div class="day-s">משעה 15:00 · לימודים פרונטליים</div>
          </div>
        </div>
        <div class="day">
          <div class="day-letter day-letter-teal">ו׳</div>
          <div>
            <div class="day-t">ימי שישי</div>
            <div class="day-s">בזום</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Registration ───────── -->
  <section id="registration" class="reg-band">
    <div class="wrap-narrow">
      <div class="reg-card">
        <div class="reg-accent" aria-hidden="true"></div>
        <div class="reg-inner">

          <!-- The form. Replaced in place by #done on success. -->
          <div id="form-panel">
            <div class="marker marker-on-dark">הרשמה</div>
            <h2 class="reg-h">נשמח לראותכם במפגש.</h2>
            <p class="reg-sub">
              מלאו את הפרטים ותקבלו מיד מייל אישור עם קישור הזום ואפשרות להוסיף את המפגש ליומן.
            </p>

            <form id="register-form" novalidate>
              <div class="field-row">
                <div class="field">
                  <label for="reg-name">שם מלא <span class="req">*</span></label>
                  <input id="reg-name" name="name" type="text" required autocomplete="name" maxlength="120" />
                </div>
                <div class="field">
                  <label for="reg-email">אימייל <span class="req">*</span></label>
                  <input id="reg-email" name="email" type="email" required autocomplete="email" dir="ltr" maxlength="200" />
                </div>
              </div>

              <div class="field">
                <label for="reg-phone">טלפון <span class="opt">(לא חובה)</span></label>
                <input id="reg-phone" name="phone" type="tel" autocomplete="tel" dir="ltr" maxlength="40" />
              </div>

              <div class="field">
                <label for="reg-question">שאלה שתרצו שנתייחס אליה <span class="opt">(לא חובה)</span></label>
                <textarea id="reg-question" name="question" rows="3" maxlength="1000"
                  placeholder="למשל: מה נדרש בקבלה? איך נראה הפרקטיקום? כמה שעות בשבוע?"></textarea>
                <p class="field-hint">נעבור על השאלות לפני המפגש ונתייחס אליהן בשיחה הפתוחה.</p>
              </div>

              <!-- Honeypot. Hidden from people, irresistible to form-filling
                   bots; the endpoint discards anything that arrives with it
                   filled. -->
              <div class="honeypot" aria-hidden="true">
                <label for="reg-website">אל תמלאו שדה זה</label>
                <input id="reg-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <button type="submit" id="reg-submit" class="btn-primary btn-block">אישור הרשמה</button>
              <p id="reg-message" class="reg-msg" style="display: none" aria-live="polite"></p>
              <p class="reg-privacy">
                הפרטים משמשים אך ורק לשליחת קישור הזום ולתזכורת לקראת המפגש. לא נצרף אתכם לשום רשימת תפוצה.
              </p>
            </form>
          </div>

          <!-- Success panel. Carries the Zoom link itself, not just "check your
               email" — a bounced or slow confirmation must not cost the meeting. -->
          <div id="done" style="display: none">
            <div class="marker marker-teal">ההרשמה נקלטה</div>
            <h2 class="reg-h">נרשמתם. נתראה במפגש.</h2>
            <p id="done-note" class="reg-sub"></p>

            <div class="zoom-box">
              <div class="zoom-l">קישור המפגש</div>
              <a id="done-zoom" href={EVENT.zoomUrl} target="_blank" rel="noopener noreferrer" dir="ltr" class="zoom-link">{EVENT.zoomUrl}</a>
              <p class="zoom-note">אותו קישור נשלח אליכם גם במייל — אין צורך לשמור אותו כאן.</p>
            </div>

            <div class="marker marker-on-dark">הוספה ליומן</div>
            <div class="btn-row">
              <a id="done-gcal" href={gcalUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">Google Calendar</a>
              <a id="done-ics" href="/api/event-ics" class="btn-ghost">Outlook / Apple</a>
            </div>

            <div class="share-block">
              <div class="marker marker-on-dark">מכירים מישהו שזה מתאים לו?</div>
              <p class="reg-sub reg-sub-tight">אפשר להעביר את ההזמנה הלאה בלחיצה אחת.</p>
              <div class="btn-row">
                <a id="share-whatsapp" href="#" target="_blank" rel="noopener noreferrer" class="btn-ghost">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                  </svg>
                  שליחה בוואטסאפ
                </a>
                <a id="share-email" href="#" class="btn-ghost">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/>
                  </svg>
                  שליחה במייל
                </a>
                <button type="button" id="share-copy" class="btn-ghost">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                  <span id="share-copy-label">העתקת קישור</span>
                </button>
              </div>
            </div>
          </div>

        </div>
      </div>

      <p class="reg-contact">
        שאלה לפני ההרשמה? אפשר לכתוב ל<a href="mailto:Yarivi@ariel.ac.il">Yarivi@ariel.ac.il</a>
      </p>
    </div>
  </section>

  <!-- ───────── Footer ───────── -->
  <footer class="foot">
    <div class="wrap-narrow foot-inner">
      <img class="foot-logo" src="/images/ariel-logo-light.png" alt="אוניברסיטת אריאל בשומרון" width="736" height="424" />
      <div class="foot-text">
        <div>{EVENT.department}</div>
        <div class="foot-dim">{EVENT.hosts.join(' · ')}</div>
      </div>
    </div>
  </footer>

  <script is:inline define:vars={{ shareText, pageUrl: EVENT.pageUrl }}>
    (function () {
      var form = document.getElementById('register-form');
      var formPanel = document.getElementById('form-panel');
      var done = document.getElementById('done');
      var msg = document.getElementById('reg-message');
      var submit = document.getElementById('reg-submit');
      if (!form) return;

      // Where did this click come from? Append ?from=whatsapp (or anything
      // else) to the link in each channel and the registration row records
      // it, so it is possible to tell afterwards which send actually worked.
      var source = '';
      try { source = new URLSearchParams(location.search).get('from') || ''; } catch (e) {}

      function show(text, isError) {
        msg.textContent = text;
        msg.style.display = 'block';
        msg.style.color = isError ? '#b3411c' : 'var(--text-muted)';
      }

      function wireShare() {
        var wa = document.getElementById('share-whatsapp');
        var em = document.getElementById('share-email');
        var copy = document.getElementById('share-copy');
        var label = document.getElementById('share-copy-label');
        if (wa) wa.href = 'https://wa.me/?text=' + encodeURIComponent(shareText);
        if (em) {
          em.href =
            'mailto:?subject=' + encodeURIComponent('הזמנה למפגש זום — תואר שני בייעוץ ארגוני וקהילתי') +
            '&body=' + encodeURIComponent(shareText);
        }
        if (copy && label) {
          copy.addEventListener('click', function () {
            var reset = function () { setTimeout(function () { label.textContent = 'העתקת קישור'; }, 1800); };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(pageUrl).then(function () { label.textContent = 'הועתק'; reset(); }, function () {});
            }
          });
        }
      }

      function succeed(res) {
        // Prefer the URLs the server returned — they are built from the same
        // event config, so a corrected time can never leave a stale link
        // baked into a cached page.
        if (res.zoom_url) {
          var z = document.getElementById('done-zoom');
          if (z) { z.href = res.zoom_url; z.textContent = res.zoom_url; }
        }
        if (res.google_calendar_url) {
          var g = document.getElementById('done-gcal');
          if (g) g.href = res.google_calendar_url;
        }
        var note = document.getElementById('done-note');
        if (note) {
          if (res.email_send === 'failed') {
            note.textContent =
              'שמרנו את ההרשמה, אבל מייל האישור לא יצא כרגע. הקישור למפגש מופיע כאן למטה — שמרו אותו, ואנחנו נשלח אישור בהמשך.';
          } else if (res.status === 'already_registered') {
            note.textContent = 'כבר הייתם רשומים — שלחנו לכם שוב את מייל האישור עם קישור הזום.';
          } else {
            note.textContent = 'שלחנו לכם מייל אישור עם קישור הזום. אם הוא לא הגיע תוך כמה דקות, כדאי לבדוק בתיקיית הספאם.';
          }
        }
        formPanel.style.display = 'none';
        done.style.display = '';
        wireShare();
        done.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = (document.getElementById('reg-name').value || '').trim();
        var email = (document.getElementById('reg-email').value || '').trim();
        var phone = (document.getElementById('reg-phone').value || '').trim();
        var question = (document.getElementById('reg-question').value || '').trim();
        var website = (document.getElementById('reg-website').value || '').trim();

        if (name.length < 2) { show('נשמח לשם המלא.', true); return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { show('כתובת המייל לא נראית תקינה.', true); return; }

        submit.disabled = true;
        submit.style.opacity = '0.6';
        show('רגע…', false);

        fetch('/api/event-register', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name: name, email: email, phone: phone, question: question, website: website, source: source }),
        })
          .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
          .then(function (res) {
            submit.disabled = false;
            submit.style.opacity = '';
            if (res.status !== 200 || !res.body.ok) {
              if (res.body && res.body.error === 'invalid_email') show('כתובת המייל לא נראית תקינה.', true);
              else if (res.body && res.body.error === 'invalid_name') show('נשמח לשם המלא.', true);
              else show('משהו השתבש. אפשר לנסות שוב עוד רגע, או לכתוב ל-Yarivi@ariel.ac.il', true);
              return;
            }
            msg.style.display = 'none';
            succeed(res.body);
          })
          .catch(function () {
            submit.disabled = false;
            submit.style.opacity = '';
            show('לא הצלחנו להגיע לשרת. אפשר לנסות שוב, או לכתוב ל-Yarivi@ariel.ac.il', true);
          });
      });
    })();
  </script>
  <style>
    /* ── Shared shells ────────────────────────────────────────────── */
    .wrap        { max-width: 1040px; margin: 0 auto; padding: 0 24px; }
    .wrap-narrow { max-width: 720px;  margin: 0 auto; padding: 0 24px; }

    .marker {
      font-size: 12px; font-weight: 600; letter-spacing: 0.14em;
      color: var(--ln-teal); margin-bottom: 18px;
    }
    .marker-on-dark { color: var(--ln-grey-mid); }
    .marker-teal    { color: var(--ln-teal-bright); }
    .marker-spaced  { margin-top: 64px; }

    /* ── Hero ─────────────────────────────────────────────────────── */
    .hero {
      position: relative; overflow: hidden;
      background: var(--ln-navy);
      /* Bottom padding clears the wedge, so the tagline never lands on it. */
      padding: 84px 0 150px;
    }
    /* Ariel's campaign creative anchors a grey triangle to the bottom-LEFT
       corner. `left`, not `inset-inline-start`: the logical property flips to
       the right in this RTL page, which puts the wedge on the wrong side and
       under the text. The mark's position is physical in their creative, so it
       is physical here. clip-path keeps a true diagonal at every width. */
    .wedge {
      position: absolute; bottom: 0; left: 0;
      width: 320px; height: 210px;
      background: var(--ln-wedge);
      clip-path: polygon(0 0, 0 100%, 100% 100%);
    }
    .wedge-logo {
      position: absolute; bottom: 24px; left: 20px;
      width: 128px; height: auto;
      /* The extracted mark is navy-on-transparent, which is exactly right
         sitting on the grey wedge. */
    }
    .hero-inner { position: relative; max-width: 1040px; margin: 0 auto; padding: 0 24px; }

    .eyebrow {
      font-size: 13px; font-weight: 500; letter-spacing: 0.1em;
      color: var(--ln-teal); margin-bottom: 26px;
    }
    .display {
      font-size: clamp(2.2rem, 7.4vw, 4.6rem);
      font-weight: 800; line-height: 1.06; letter-spacing: -0.015em;
      color: var(--ln-grey); margin: 0 0 24px;
    }
    .display-teal { color: var(--ln-teal-bright); }
    .lede {
      font-size: clamp(1.05rem, 2.4vw, 1.4rem); line-height: 1.6;
      color: var(--ln-grey); max-width: 34ch; margin: 0 0 42px; font-weight: 300;
    }

    .facts {
      display: grid; grid-template-columns: repeat(3, 1fr);
      border: 1px solid var(--ln-navy-line); border-radius: 14px;
      background: rgba(193, 195, 198, 0.05);
      max-width: 720px; overflow: hidden;
    }
    .fact { padding: 22px 20px; }
    .fact + .fact { border-inline-start: 1px solid var(--ln-navy-line); }
    .fact-l { font-size: 11px; letter-spacing: 0.12em; color: var(--ln-grey-mid); margin-bottom: 10px; }
    .fact-v { font-size: clamp(1.4rem, 4vw, 2.1rem); font-weight: 700; line-height: 1; color: #fff; margin-bottom: 6px; }
    .fact-s { font-size: 13px; color: var(--ln-grey-mid); }

    .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 38px; }
    .cta-note { font-size: 14px; color: var(--ln-grey-mid); }

    .btn-primary {
      display: inline-block; text-align: center;
      background: var(--ln-teal); color: #fff; text-decoration: none;
      padding: 16px 34px; border-radius: 999px;
      font-size: 15px; font-weight: 600; border: 0; cursor: pointer;
      transition: background-color 0.2s ease;
    }
    .btn-primary:hover { background: var(--ln-teal-bright); }
    .btn-block { width: 100%; margin-top: 28px; }

    .tagline {
      margin-top: 64px; font-size: clamp(0.95rem, 2.2vw, 1.15rem);
      color: var(--ln-grey-mid); font-weight: 500;
      /* Ariel set this line against the right edge, opposite the wedge. */
      text-align: start;
    }
    .tagline-teal { color: var(--ln-teal-bright); display: block; }

    /* ── Light reading band ───────────────────────────────────────── */
    .light-band { background: var(--ln-light); color: var(--ln-ink); padding: 76px 0 84px; }
    .greet   { font-size: clamp(1.4rem, 3.4vw, 1.9rem); font-weight: 700; margin: 0 0 20px; }
    .body-lg { font-size: clamp(1.05rem, 2.3vw, 1.25rem); line-height: 1.7; margin: 0 0 20px; }
    .body-md { font-size: 1.05rem; line-height: 1.7; color: var(--ln-ink-soft); margin: 0; }

    .hosts { display: flex; flex-wrap: wrap; gap: 26px; margin-top: 34px; }
    .host  { display: flex; align-items: center; gap: 12px; font-size: 16px; }
    .host-badge {
      width: 46px; height: 46px; border-radius: 999px; flex-shrink: 0;
      background: var(--ln-navy); color: var(--ln-teal-bright);
      display: flex; align-items: center; justify-content: center;
      font-size: 19px; font-weight: 700;
    }

    .agenda { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .agenda-card { background: #fff; border-radius: 16px; padding: 28px 24px; }
    .agenda-n { font-size: 13px; font-weight: 700; color: var(--ln-teal); margin-bottom: 18px; }
    .agenda-t { font-size: 1.3rem; font-weight: 700; margin-bottom: 10px; }
    .agenda-b { font-size: 0.95rem; line-height: 1.65; color: var(--ln-ink-soft); margin: 0; }

    .days { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .day {
      display: flex; align-items: baseline; gap: 20px;
      background: #fff; border-radius: 16px; padding: 30px 28px;
    }
    .day-teal { background: var(--ln-navy); color: var(--ln-grey); }
    .day-letter { font-size: clamp(2.2rem, 6vw, 3.2rem); font-weight: 800; line-height: 1; color: var(--ln-teal-bright); }
    .day-letter-teal { color: var(--ln-teal); }
    .day-t { font-size: 1.25rem; font-weight: 700; margin-bottom: 5px; }
    .day-s { font-size: 0.9rem; opacity: 0.75; }

    /* ── Registration ─────────────────────────────────────────────── */
    .reg-band { background: var(--ln-navy); padding: 76px 0 72px; scroll-margin-top: 20px; }
    .reg-card {
      background: var(--ln-navy-soft); border-radius: 20px; overflow: hidden;
      border: 1px solid var(--ln-navy-line);
    }
    .reg-accent { height: 5px; background: var(--ln-teal); }
    .reg-inner  { padding: 34px 28px 38px; }

    .reg-h   { font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 800; color: #fff; margin: 0 0 14px; }
    .reg-sub { font-size: 1rem; line-height: 1.65; color: var(--ln-grey); margin: 0 0 30px; }
    .reg-sub-tight { margin-bottom: 18px; }

    .field-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .field { margin-bottom: 18px; }
    .field label {
      display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.08em;
      color: var(--ln-grey-mid); margin-bottom: 9px;
    }
    .req { color: var(--ln-teal-bright); }
    .opt { font-weight: 400; letter-spacing: 0; }
    .field input, .field textarea {
      width: 100%; box-sizing: border-box;
      background: rgba(12, 23, 39, 0.55);
      border: 1px solid var(--ln-navy-line); border-radius: 12px;
      padding: 14px 16px; color: #fff;
      /* 16px keeps iOS from zooming the viewport when the field takes focus. */
      font-size: 16px; font-family: inherit;
      outline: none; transition: border-color 0.2s ease;
    }
    .field input:focus, .field textarea:focus { border-color: var(--ln-teal); }
    .field input::placeholder, .field textarea::placeholder { color: rgba(193, 195, 198, 0.45); }
    .field input[dir="ltr"] { text-align: start; }
    .field textarea { resize: vertical; line-height: 1.6; }
    .field-hint { font-size: 12px; color: var(--ln-grey-mid); margin: 9px 0 0; }

    .honeypot { position: absolute; left: -9999px; top: -9999px; }
    .reg-msg { font-size: 14px; line-height: 1.6; margin: 16px 0 0; color: var(--ln-grey); }
    .reg-privacy { font-size: 12px; line-height: 1.6; color: var(--ln-grey-mid); margin: 22px 0 0; }
    .reg-contact { text-align: center; font-size: 14px; color: var(--ln-grey-mid); margin: 28px 0 0; }
    .reg-contact a { color: var(--ln-teal-bright); }

    .zoom-box {
      background: rgba(12, 23, 39, 0.55); border: 1px solid var(--ln-navy-line);
      border-radius: 14px; padding: 20px 22px; margin-bottom: 30px;
    }
    .zoom-l { font-size: 11px; letter-spacing: 0.12em; color: var(--ln-grey-mid); margin-bottom: 12px; }
    .zoom-link {
      display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.95rem; color: var(--ln-teal-bright);
      text-decoration: underline; text-underline-offset: 4px;
      word-break: break-all; text-align: start;
    }
    .zoom-note { font-size: 12px; color: var(--ln-grey-mid); margin: 12px 0 0; }

    .btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 30px; }
    .btn-ghost {
      flex: 1 1 180px;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      border: 1px solid var(--ln-navy-line); border-radius: 999px;
      padding: 13px 20px; font-size: 14px; font-family: inherit;
      color: var(--ln-grey); background: transparent; text-decoration: none;
      cursor: pointer; transition: border-color 0.2s ease, color 0.2s ease;
    }
    .btn-ghost:hover { border-color: var(--ln-teal); color: #fff; }
    .share-block { border-top: 1px solid var(--ln-navy-line); padding-top: 26px; }

    /* ── Footer ───────────────────────────────────────────────────── */
    .foot { background: var(--ln-navy-deep); padding: 40px 0 48px; }
    .foot-inner { display: flex; align-items: center; gap: 22px; }
    .foot-logo { width: 116px; height: auto; opacity: 0.9; }
    .foot-text { font-size: 14px; color: var(--ln-grey); line-height: 1.6; }
    .foot-dim { color: var(--ln-grey-mid); }

    /* ── Narrow screens ───────────────────────────────────────────── */
    @media (max-width: 760px) {
      .agenda, .days, .field-row, .facts { grid-template-columns: 1fr; }
      /* Stacked fact cells need horizontal rules, not vertical ones. */
      .fact + .fact { border-inline-start: 0; border-top: 1px solid var(--ln-navy-line); }
      .hero { padding: 60px 0 200px; }
      /* The wedge widens at the foot of the hero so the mark still has a
         light ground to sit on when space is tight. */
      .wedge { width: 82%; height: 165px; }
      .wedge-logo { width: 104px; bottom: 20px; left: 16px; }
      .tagline { margin-top: 44px; }
      .lede { max-width: none; }
      .reg-inner { padding: 28px 20px 32px; }
      .btn-primary { width: 100%; }
      .cta-row { gap: 14px; }
    }
  </style>
</LandingLayout>
