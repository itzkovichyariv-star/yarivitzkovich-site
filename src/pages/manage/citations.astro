---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Build-time: extract the full paper list so the browser can send it to
// POST /api/citations. Papers without a doi fall back to title search on
// Semantic Scholar — so we include all papers, not just the ones with DOIs.
const pubs = await getCollection('publications');
const allPapers = pubs
  .filter((p) => ['published', 'in-press'].includes(p.data.status))
  .sort((a, b) => b.data.year - a.data.year)
  .map((p) => ({
    slug: p.data.slug,
    doi: p.data.doi ?? null,
    title: p.data.title,
    year: p.data.year,
  }));

const withDoi    = allPapers.filter((p) => p.doi).length;
const withoutDoi = allPapers.filter((p) => !p.doi).length;
---
<BaseLayout
  title="Citations — Admin — Yariv Itzkovich"
  description="Citation analytics, h-index, i-10, and AI-powered promotion insights."
>
  <section class="max-w-5xl mx-auto px-6 md:px-10 pt-32 pb-16">
    <div class="font-mono text-xs uppercase tracking-widest text-soft mb-4">
      <a href="/manage" class="underline underline-offset-4 hover:opacity-70">← Admin</a> · Citations
    </div>
    <h1
      class="font-display leading-[0.95] mb-2"
      style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 300"
    >
      Citations.
    </h1>
    <p class="text-sm text-muted mb-8">
      {withDoi} papers have DOIs · {withoutDoi} use title search as fallback ·
      refreshed daily, emailed on changes.
    </p>

    <div id="gate" class="text-muted leading-relaxed" style="display: none">
      Not signed in as owner. <a href="/manage" class="underline underline-offset-4">Go back</a>.
    </div>

    <!-- Action row -->
    <div id="action-row" style="display: none" class="flex flex-wrap items-center gap-3 mb-10">
      <button
        id="refresh-btn"
        class="font-mono text-xs uppercase tracking-widest border rounded px-4 py-2 hover:opacity-70 transition-opacity"
        style="border-color: var(--divider)"
      >
        Refresh from Semantic Scholar
      </button>
      <button
        id="ai-btn"
        class="font-mono text-xs uppercase tracking-widest border rounded px-4 py-2 hover:opacity-70 transition-opacity"
        style="border-color: var(--divider)"
      >
        Generate AI insights
      </button>
      <span id="status-msg" class="font-mono text-xs uppercase tracking-widest text-soft"></span>
    </div>

    <!-- Progress bar shown while fetching -->
    <div id="progress-bar" style="display: none" class="mb-8">
      <div class="font-mono text-xs uppercase tracking-widest text-soft mb-2" id="progress-label">Fetching from Semantic Scholar…</div>
      <div class="rounded-full overflow-hidden" style="height: 3px; background: var(--divider)">
        <div id="progress-fill" class="h-full rounded-full" style="background: var(--text); width: 0%; transition: width 0.4s ease"></div>
      </div>
    </div>

    <!-- Summary stats — two rows: indices, then citation breakdown -->
    <div id="stats-row" style="display: none" class="mb-10 space-y-3">
      <!-- Row 1: academic indices -->
      <div class="grid grid-cols-3 gap-3">
        <div class="border rounded-lg p-5 text-center" style="border-color: var(--divider)">
          <div id="stat-h" class="text-3xl font-display mb-1" style="font-weight: 300">—</div>
          <div class="font-mono text-[10px] uppercase tracking-widest text-soft">h-index</div>
        </div>
        <div class="border rounded-lg p-5 text-center" style="border-color: var(--divider)">
          <div id="stat-i10" class="text-3xl font-display mb-1" style="font-weight: 300">—</div>
          <div class="font-mono text-[10px] uppercase tracking-widest text-soft">i-10 index</div>
        </div>
        <div class="border rounded-lg p-5 text-center" style="border-color: var(--divider)">
          <div id="stat-total" class="text-3xl font-display mb-1" style="font-weight: 300">—</div>
          <div class="font-mono text-[10px] uppercase tracking-widest text-soft">Total citations</div>
        </div>
      </div>
      <!-- Row 2: self vs external citation breakdown -->
      <div class="grid grid-cols-2 gap-3">
        <div class="border rounded-lg p-5 text-center" style="border-color: var(--divider)">
          <div id="stat-external" class="text-3xl font-display mb-1" style="font-weight: 300">—</div>
          <div class="font-mono text-[10px] uppercase tracking-widest text-soft">External citations</div>
        </div>
        <div class="border rounded-lg p-5 text-center" style="border-color: var(--divider)">
          <div id="stat-self" class="text-3xl font-display mb-1" style="font-weight: 300">—</div>
          <div id="stat-self-label" class="font-mono text-[10px] uppercase tracking-widest text-soft">Self-citations</div>
        </div>
      </div>
    </div>

    <!-- Per-paper list -->
    <div id="loading" class="text-muted text-sm">Loading…</div>
    <div id="empty" class="text-muted text-sm" style="display: none">
      No citation data yet. Click "Refresh from Semantic Scholar" to pull live data.
    </div>
    <div id="error-msg" class="text-sm mb-6" style="display: none; color: #b3411c"></div>
    <div id="papers-list" class="space-y-3 mb-14" style="display: none"></div>

    <!-- AI insights section -->
    <div id="ai-section" style="display: none">
      <div class="font-mono text-xs uppercase tracking-widest text-soft mb-5">AI insights</div>
      <div
        id="ai-content"
        class="text-sm leading-relaxed border rounded-lg p-6"
        style="border-color: var(--divider)"
      ></div>
      <div id="ai-meta" class="font-mono text-[10px] uppercase tracking-widest text-soft mt-3"></div>
    </div>
  </section>

  <script is:inline define:vars={{ allPapers }}>
    (function () {
      var gate        = document.getElementById('gate');
      var actionRow   = document.getElementById('action-row');
      var statsRow    = document.getElementById('stats-row');
      var loading     = document.getElementById('loading');
      var empty       = document.getElementById('empty');
      var errorMsg    = document.getElementById('error-msg');
      var papersList  = document.getElementById('papers-list');
      var statusMsg   = document.getElementById('status-msg');
      var refreshBtn  = document.getElementById('refresh-btn');
      var aiBtn       = document.getElementById('ai-btn');
      var aiSection   = document.getElementById('ai-section');
      var aiContent   = document.getElementById('ai-content');
      var aiMeta      = document.getElementById('ai-meta');
      var statTotal    = document.getElementById('stat-total');
      var statH        = document.getElementById('stat-h');
      var statI10      = document.getElementById('stat-i10');
      var statSelf     = document.getElementById('stat-self');
      var statSelfLbl  = document.getElementById('stat-self-label');
      var statExternal = document.getElementById('stat-external');
      var progressBar  = document.getElementById('progress-bar');
      var progressFill = document.getElementById('progress-fill');
      var progressLbl  = document.getElementById('progress-label');

      var progressTimer = null;
      function startProgress() {
        progressBar.style.display = '';
        progressFill.style.width = '0%';
        var pct = 0;
        // Animate to ~90% over 2 minutes, then stall — completes on success
        progressTimer = setInterval(function () {
          pct = pct < 85 ? pct + (85 - pct) * 0.015 : pct;
          progressFill.style.width = pct.toFixed(1) + '%';
        }, 500);
      }
      function finishProgress(label) {
        clearInterval(progressTimer);
        progressFill.style.width = '100%';
        if (label) progressLbl.textContent = label;
        setTimeout(function () { progressBar.style.display = 'none'; }, 1500);
      }

      // slug → title lookup built from the build-time list
      var titleMap = {};
      (allPapers || []).forEach(function (p) { titleMap[p.slug] = p.title; });

      function fmtTs(unix) {
        if (!unix) return '—';
        return new Date(unix * 1000).toLocaleString(undefined, {
          day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
        });
      }

      function esc(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      // Lightweight markdown → HTML (bold, italic, h2/h3/h4, bullets)
      function md(text) {
        return text
          .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
          .replace(/^#### (.+)$/gm,'<h4 class="font-display mt-6 mb-1" style="font-weight:500;font-size:.9em">$1</h4>')
          .replace(/^### (.+)$/gm,'<h3 class="font-display mt-6 mb-2" style="font-weight:500">$1</h3>')
          .replace(/^## (.+)$/gm,'<h2 class="font-display mt-8 mb-2" style="font-weight:400;font-size:1.1em">$1</h2>')
          .replace(/^# (.+)$/gm,'<h2 class="font-display mt-8 mb-2" style="font-weight:400;font-size:1.15em">$1</h2>')
          .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
          .replace(/\*(.+?)\*/g,'<em>$1</em>')
          .replace(/^- (.+)$/gm,'<li class="ml-4" style="list-style:disc outside;margin:.25em 0">$1</li>')
          .replace(/(<li[^>]*>[\s\S]*?<\/li>\n?)+/g,'<ul class="my-2">$&</ul>')
          .replace(/\n\n+/g,'</p><p class="mt-3">')
          .replace(/^/,'<p class="mt-2">')
          .replace(/$/,'</p>');
      }

      function isSelf(citing) {
        return (citing.authors || []).some(function (a) {
          return (a.name || '').toLowerCase().includes('itzkovich');
        });
      }

      function renderPaper(p) {
        var title    = esc(titleMap[p.paper_slug] || p.paper_slug);
        var selfN    = p.self_citation_count || 0;
        var external = (p.citation_count || 0) - selfN;
        var s2url    = p.semantic_scholar_id
          ? 'https://www.semanticscholar.org/paper/' + esc(p.semantic_scholar_id)
          : null;

        // Show external citations first, then self-citations collapsed at end
        var externalCiting = (p.citing_papers || []).filter(function (c) { return !isSelf(c); });
        var topCiting = externalCiting.slice(0, 4).map(function (c) {
          var authors = (c.authors || []).slice(0, 2).map(function (a) { return esc(a.name || ''); }).join(', ');
          var doi = (c.externalIds || {}).DOI;
          var cTitle = esc(c.title || 'Untitled');
          var linked = doi
            ? '<a href="https://doi.org/' + esc(doi) + '" target="_blank" rel="noopener" class="underline underline-offset-2 hover:opacity-70">' + cTitle + '</a>'
            : cTitle;
          return '<div class="text-soft mt-1 ml-4 text-xs">· ' + linked +
            (c.year ? ' (' + c.year + ')' : '') +
            (authors ? ' — ' + authors : '') + '</div>';
        }).join('');

        var selfTag = selfN > 0
          ? '<span class="font-mono text-[10px] uppercase tracking-widest" style="opacity:.5">' + selfN + ' self</span>'
          : '';

        return [
          '<div class="flex items-start justify-between gap-4 flex-wrap mb-2">',
            '<div class="font-display" style="font-weight:400">' + title + '</div>',
            '<div class="flex items-center gap-3 font-mono text-xs text-soft shrink-0">',
              s2url ? '<a href="' + s2url + '" target="_blank" rel="noopener" class="underline underline-offset-2 hover:opacity-70">S2 ↗</a>' : '',
              '<span>fetched ' + esc(fmtTs(p.fetched_at)) + '</span>',
            '</div>',
          '</div>',
          '<div class="flex gap-4 items-baseline font-mono text-xs text-muted mb-1">',
            '<span style="font-variant-numeric:tabular-nums">' + p.citation_count + ' total</span>',
            '<span>' + external + ' external</span>',
            selfTag,
            p.doi ? '<span class="text-soft ml-auto">DOI&thinsp;' + esc(p.doi) + '</span>' : '<span class="text-soft ml-auto opacity-50">title search</span>',
          '</div>',
          topCiting ? '<div class="mt-2">' + topCiting + '</div>' : '',
        ].join('');
      }

      function showCitations(data) {
        var total = data.totalCitations || 0;
        var self  = data.totalSelfCitations || 0;
        var ext   = total - self;
        var pct   = total > 0 ? Math.round(self / total * 100) : 0;

        statTotal.textContent    = total.toLocaleString();
        statH.textContent        = data.hIndex || 0;
        statI10.textContent      = data.i10 || 0;
        statExternal.textContent = ext.toLocaleString();
        statSelf.textContent     = self.toLocaleString();
        statSelfLbl.textContent  = 'Self-citations (' + pct + '%)';
        statsRow.style.display   = '';

        var papers = data.papers || [];
        if (papers.length === 0) { empty.style.display = ''; return; }

        papersList.innerHTML = papers.map(function (p) {
          return '<div class="border rounded-lg p-5" style="border-color: var(--divider)">' + renderPaper(p) + '</div>';
        }).join('');
        papersList.style.display = '';
      }

      function showAiInsight(data) {
        if (!data || !data.insight) return;
        aiContent.innerHTML = md(data.insight);
        aiMeta.textContent  = 'Generated ' + fmtTs(data.generated_at);
        aiSection.style.display = '';
      }

      function loadCitations() {
        fetch('/api/citations', { credentials: 'same-origin' })
          .then(function (r) {
            if (r.status === 401) { loading.style.display = 'none'; gate.style.display = ''; throw new Error('unauthorized'); }
            if (!r.ok) throw new Error('http_' + r.status);
            return r.json();
          })
          .then(function (data) {
            loading.style.display = 'none';
            actionRow.style.display = '';
            if (!data.papers || data.papers.length === 0) {
              empty.style.display = '';
            } else {
              showCitations(data);
            }
          })
          .catch(function (err) {
            if (err.message === 'unauthorized') return;
            loading.style.display = 'none';
            actionRow.style.display = '';
            errorMsg.textContent = "Couldn't load citation data: " + err.message;
            errorMsg.style.display = '';
          });
      }

      function loadAi() {
        fetch('/api/ai-insights', { credentials: 'same-origin' })
          .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
          .then(showAiInsight)
          .catch(function () {});
      }

      refreshBtn.addEventListener('click', function () {
        refreshBtn.disabled = true;
        statusMsg.textContent = '';
        startProgress();
        fetch('/api/citations', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ papers: allPapers }),
        })
          .then(function (r) { if (!r.ok) throw new Error('http_' + r.status); return r.json(); })
          .then(function (data) {
            var warns = [];
            if (data.not_found > 0) warns.push(data.not_found + ' not found');
            if (data.errors && data.errors.length) warns.push(data.errors.length + ' error(s)');
            var extra = warns.length ? ' · ' + warns.join(' · ') : '';
            var msg = 'Done — ' + (data.refreshed || 0) + ' papers refreshed' + extra;
            finishProgress(msg);
            statusMsg.textContent = msg;
            statsRow.style.display   = 'none';
            papersList.style.display = 'none';
            empty.style.display      = 'none';
            loading.style.display    = '';
            loadCitations();
          })
          .catch(function (err) {
            finishProgress('Failed — ' + err.message);
            statusMsg.textContent = 'Failed — ' + err.message;
          })
          .finally(function () { refreshBtn.disabled = false; });
      });

      aiBtn.addEventListener('click', function () {
        aiBtn.disabled = true;
        statusMsg.textContent = 'Generating AI insights (this takes ~10 s)…';
        fetch('/api/ai-insights', { method: 'POST', credentials: 'same-origin' })
          .then(function (r) { if (!r.ok) throw new Error('http_' + r.status); return r.json(); })
          .then(function (data) {
            statusMsg.textContent = 'Done.';
            showAiInsight(data);
          })
          .catch(function (err) { statusMsg.textContent = 'AI failed — ' + err.message; })
          .finally(function () { aiBtn.disabled = false; });
      });

      loadCitations();
      loadAi();
    })();
  </script>
</BaseLayout>
