---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreakdownDrawer from '../../components/BreakdownDrawer';
import { getCollection } from 'astro:content';

// We need the publications list for paper-title resolution inside the
// event browser (same data the /live page passes to BreakdownDrawer).
const entries = await getCollection('publications');
const papers = entries.map((e) => ({ slug: e.data.slug, title: e.data.title }));
---
<BaseLayout
  title="Events — Admin — Yariv Itzkovich"
  description="Detailed event-by-event activity browser."
>
  <section class="max-w-6xl mx-auto px-6 md:px-10 pt-32 pb-16">
    <div class="font-mono text-xs uppercase tracking-widest text-soft mb-4">
      <a href="/manage" class="underline underline-offset-4 hover:opacity-70">Admin</a> · Events
    </div>
    <h1
      class="font-display leading-[0.95] mb-2"
      style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 300"
    >
      Events.
    </h1>
    <p class="text-muted leading-relaxed mb-10 max-w-2xl">
      Every visit and download since launch, with geo and timing details. Filter by range. Same data the live globe shows, presented for inspection.
    </p>

    <div id="gate" class="text-muted leading-relaxed" style="display: none">
      Not signed in as owner. <a href="/manage" class="underline underline-offset-4">Go back</a>.
    </div>

    <div id="events-content" style="display: none">
      <BreakdownDrawer client:load open={true} onClose={() => {}} papers={papers} mode="inline" />
    </div>
  </section>

  <script is:inline>
    // Auth gate (same pattern as the other /manage pages): try /api/me;
    // if the visitor is owner, show the embedded event browser. The
    // BreakdownDrawer in inline mode does its own /live/details fetch
    // which also enforces owner auth, so this is belt-and-braces.
    fetch('/api/me', { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((data) => {
        var content = document.getElementById('events-content');
        var gate = document.getElementById('gate');
        if (data && data.owner) {
          if (content) content.style.display = '';
        } else {
          if (gate) gate.style.display = '';
        }
      })
      .catch(() => {
        var gate = document.getElementById('gate');
        if (gate) gate.style.display = '';
      });
  </script>
</BaseLayout>
