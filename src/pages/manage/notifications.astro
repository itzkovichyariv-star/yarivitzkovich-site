---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Notifications — Admin — Yariv Itzkovich"
  description="History of subscriber emails sent."
>
  <section class="max-w-5xl mx-auto px-6 md:px-10 pt-32 pb-16">
    <div class="font-mono text-xs uppercase tracking-widest text-soft mb-4">
      <a href="/manage" class="underline underline-offset-4 hover:opacity-70">← Admin</a> · Notifications
    </div>
    <h1
      class="font-display leading-[0.95] mb-10"
      style="font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 300"
    >
      Notifications.
    </h1>

    <div id="gate" class="text-muted leading-relaxed" style="display: none">
      Not signed in as owner. <a href="/manage" class="underline underline-offset-4">Go back</a>.
    </div>
    <div id="loading" class="text-muted text-sm">Loading…</div>
    <div id="empty" class="text-muted text-sm" style="display: none">No notifications have been sent yet.</div>
    <div id="error" class="text-sm" style="display: none; color: #b3411c"></div>

    <table id="table" class="w-full text-sm" style="border-collapse: collapse; display: none">
      <thead>
        <tr class="font-mono text-xs uppercase tracking-widest text-soft text-left">
          <th class="py-3 pr-4 border-b" style="border-color: var(--divider)">When</th>
          <th class="py-3 pr-4 border-b" style="border-color: var(--divider)">Paper</th>
          <th class="py-3 pr-4 border-b text-right" style="border-color: var(--divider)">Sent</th>
          <th class="py-3 pr-2 border-b text-right" style="border-color: var(--divider)">Errors</th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </section>

  <script is:inline>
    (function () {
      var loading = document.getElementById('loading');
      var empty = document.getElementById('empty');
      var errorEl = document.getElementById('error');
      var gate = document.getElementById('gate');
      var table = document.getElementById('table');
      var rowsEl = document.getElementById('rows');

      function fmtTs(unix) {
        if (!unix) return '—';
        var d = new Date(unix * 1000);
        return d.toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      }

      function escape(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      fetch('/api/manage/notifications', { credentials: 'same-origin' })
        .then(function (r) {
          if (r.status === 401) { loading.style.display = 'none'; gate.style.display = ''; throw new Error('unauthorized'); }
          if (!r.ok) throw new Error('http_' + r.status);
          return r.json();
        })
        .then(function (data) {
          loading.style.display = 'none';
          if (!data.entries.length) { empty.style.display = ''; return; }
          rowsEl.innerHTML = data.entries.map(function (e) {
            return '<tr class="border-b" style="border-color: var(--divider)">' +
              '<td class="py-3 pr-4 text-xs text-muted whitespace-nowrap">' + escape(fmtTs(e.ts)) + '</td>' +
              '<td class="py-3 pr-4"><a href="/publications/' + encodeURIComponent(e.paper_slug) + '" class="underline underline-offset-4 hover:opacity-70 font-display italic">' + escape(e.paper_title) + '</a></td>' +
              '<td class="py-3 pr-4 text-right font-mono text-sm tabular-nums">' + e.sent_count + '</td>' +
              '<td class="py-3 pr-2 text-right font-mono text-sm tabular-nums" style="' + (e.error_count > 0 ? 'color:#b3411c' : '') + '">' + e.error_count + '</td>' +
              '</tr>';
          }).join('');
          table.style.display = '';
        })
        .catch(function (err) {
          if (String(err.message) === 'unauthorized') return;
          loading.style.display = 'none';
          errorEl.textContent = "Couldn't load notifications.";
          errorEl.style.display = '';
        });
    })();
  </script>
</BaseLayout>
