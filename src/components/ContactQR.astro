---
// ContactQR.astro — a build-time-generated vCard QR code for the contact zone.
//
// What it does: encodes Yariv's contact details as a vCard 3.0 string and
// renders it as an inline SVG QR code. When someone scans it with a phone
// camera (in person, over a video call, or from a forwarded WhatsApp image),
// their phone offers "Add to Contacts" prefilled with the details below.
//
// Design choices:
//   • Generated at `npm run build` time via the `qrcode` lib → inline SVG.
//     No third-party QR API, no external image, no runtime JS, no tracking.
//   • Rendered as a cream tile with maroon modules in BOTH themes. The
//     #contact footer is maroon in light AND dark mode, so a fixed cream
//     tile contrasts reliably either way — and dark-on-light is the
//     orientation every scanner reads most reliably (inverted codes are
//     hit-or-miss on older cameras).
//   • Error-correction level H (30%) so the center "Y" monogram can sit on
//     top without breaking scannability.
//   • Everything encoded here is ALREADY public on the site (email +
//     WhatsApp are live mailto:/wa.me links in the footer; ORCID is a
//     public profile). The QR adds convenience, not new exposure.
import QRCode from 'qrcode';
import { site } from '../data/site';

interface Props {
  lang?: 'en' | 'he';
}
const { lang = 'en' } = Astro.props;

// WhatsApp number used elsewhere in the footer (wa.me/972523975027).
const phoneE164 = '+972523975027';

// vCard 3.0. Spec wants CRLF between properties; most parsers accept LF,
// but CRLF is safest across iOS/Android contact importers.
//
// Kept deliberately lean: every extra character makes the QR denser (more
// modules), which shrinks each module and hurts scannability at this tile
// size. We drop optional TYPE params and the long department string, but
// keep the fields that matter for a contact card (name, org, title, email,
// mobile, website, ORCID).
const VCARD = [
  'BEGIN:VCARD',
  'VERSION:3.0',
  'N:Itzkovich;Yariv;;;',
  'FN:Yariv Itzkovich',
  'ORG:Ariel University',
  'TITLE:Associate Editor, Journal of Managerial Psychology',
  `EMAIL:${site.email}`,
  `TEL;TYPE=CELL:${phoneE164}`,
  'URL:https://yarivitzkovich.org',
  `URL:${site.profiles.orcid}`,
  'END:VCARD',
].join('\r\n');

// Generate the QR as an SVG string. We theme it on-brand: maroon modules
// (#7A1E2B = --color-accent) on a cream field (#F4EFE6 = --color-bg).
//
// Error-correction level M (15%): the center monogram covers only ~3% of
// the code's area, so M's redundancy is more than enough to read through
// it — and M keeps the module count low so each module stays big enough to
// scan reliably at this tile size. (Level H tripled the data overhead and
// produced a grid too fine to decode — caught by 11-contact-qr.mjs.)
// margin:1 because the cream CSS padding around the SVG already provides
// the bulk of the quiet zone scanners need.
// Designed "dots" style: circular maroon modules on cream, with the three
// corner finder patterns drawn as rounded squares (the scan anchors — kept
// solid + rounded for reliability + style). Built from the raw module matrix
// rather than the lib's plain-square SVG. Decode-verified at both the desktop
// (168px) and mobile (132px) sizes by scripts/audit/11-contact-qr.mjs.
let qrSvg = '';
try {
  const qr   = QRCode.create(VCARD, { errorCorrectionLevel: 'M' });
  const size = qr.modules.size;
  const data = qr.modules.data;
  const dark = (r, c) => (r >= 0 && c >= 0 && r < size && c < size ? data[r * size + c] : 0);
  const M    = 1;                       // quiet-zone margin (modules) — thin, even cream frame
  const dim  = size + M * 2;
  const FG   = '#7A1E2B', BG = '#F4EFE6';
  const inFinder = (r, c) =>
    (r < 7 && c < 7) || (r < 7 && c >= size - 7) || (r >= size - 7 && c < 7);
  const finder = (x, y) =>
    `<rect x="${x}" y="${y}" width="7" height="7" rx="2.1" fill="${FG}"/>` +
    `<rect x="${x + 1}" y="${y + 1}" width="5" height="5" rx="1.4" fill="${BG}"/>` +
    `<rect x="${x + 2}" y="${y + 2}" width="3" height="3" rx="0.9" fill="${FG}"/>`;
  let body = `<rect width="${dim}" height="${dim}" fill="${BG}"/>`;
  body += finder(M, M) + finder(M + size - 7, M) + finder(M, M + size - 7);
  // Data modules as slightly-overlapping rounded squares: the 0.1 overlap
  // merges adjacent dark modules into soft connected blobs (the modern
  // "liquid" QR look) while keeping full ink coverage so it stays scannable
  // at small sizes (pure dots were too thin — failed the decode gate).
  for (let r = 0; r < size; r++) {
    for (let c = 0; c < size; c++) {
      if (!dark(r, c) || inFinder(r, c)) continue;
      body += `<rect x="${c + M - 0.05}" y="${r + M - 0.05}" width="1.1" height="1.1" rx="0.4" fill="${FG}"/>`;
    }
  }
  qrSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${dim} ${dim}" shape-rendering="geometricPrecision">${body}</svg>`;
} catch (e) {
  // If generation ever fails, render nothing rather than break the page.
  qrSvg = '';
}

const copy = {
  en: { caption: 'Scan to save my details', aria: 'QR code — scan to save Yariv Itzkovich’s contact details' },
  he: { caption: 'סרקו לשמירת פרטי הקשר שלי', aria: 'קוד QR — סריקה לשמירת פרטי הקשר של יריב איצקוביץ׳' },
}[lang];
---
{qrSvg && (
  <figure class="qr" aria-label={copy.aria} data-contact-qr data-vcard-len={VCARD.length}>
    <div class="qr-tile">
      <div class="qr-svg" set:html={qrSvg} />
      <span class="qr-monogram" aria-hidden="true">Y</span>
    </div>
    <figcaption class="qr-caption">{copy.caption}</figcaption>
  </figure>
)}

<style>
  .qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }
  .qr-tile {
    position: relative;
    width: 100%;
    max-width: 168px;              /* compact, to sit quietly in the clean footer */
    aspect-ratio: 1 / 1;
    background: #F4EFE6;            /* cream tile — fixed in both themes for scan reliability */
    border-radius: 10px;
    /* Thin, uniform cream border. The QR's own 1-module quiet zone is baked
       into the SVG (qrcode margin:1), so this padding only needs to be a
       hair more — no thick white frame. */
    padding: 4px;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.15);
  }
  /* On phones (below Tailwind's md breakpoint, where the footer stacks) the
     QR is a secondary element — shrink it so it doesn't dominate. It stays
     scannable at this size on a retina screen (verified by 11-contact-qr at
     deviceScaleFactor 3). Desktop keeps the full 168px for easy scanning. */
  @media (max-width: 767px) {
    .qr-tile { max-width: 132px; }
    .qr-caption { font-size: 0.62rem; }
  }
  .qr-svg { width: 100%; height: 100%; display: block; }
  .qr-svg :global(svg) { width: 100%; height: 100%; display: block; }
  /* Center monogram: a small cream disc with the maroon "Y", sitting in the
     QR's reserved center (safe because error-correction level H tolerates a
     ~30% obstruction). */
  .qr-monogram {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 18%;
    height: 18%;
    display: grid;
    place-items: center;
    background: #F4EFE6;
    border-radius: 50%;
    color: #7A1E2B;
    font-family: var(--font-display, Georgia, serif);
    font-weight: 600;
    font-size: clamp(0.85rem, 4.2vw, 1.15rem);
    line-height: 1;
    box-shadow: 0 0 0 3px #F4EFE6;  /* a clean cream halo so modules don't crowd the letter */
    user-select: none;
  }
  .qr-caption {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
    text-align: center;
  }
</style>
