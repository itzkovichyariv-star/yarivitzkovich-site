---
import { site } from '../data/site';
import ContactQR from './ContactQR.astro';

interface Props {
  lang?: 'en' | 'he';
}
const { lang = 'en' } = Astro.props;

const profileLinks: Array<{ label: string; href: string }> = [
  { label: 'Google Scholar', href: site.profiles.googleScholar },
  { label: 'ORCID', href: site.profiles.orcid },
  { label: 'ResearchGate', href: site.profiles.researchGate },
  { label: 'Web of Science', href: site.profiles.webOfScience },
  { label: 'LinkedIn', href: site.profiles.linkedin },
  { label: 'GitHub (templates)', href: site.profiles.github },
  { label: 'Mastodon', href: site.profiles.mastodon },
  { label: 'Bluesky', href: site.profiles.bluesky },
].filter((link) => Boolean(link.href));

const showProfiles = site.display.footerProfiles && profileLinks.length > 0;
const showCv = site.display.findCv;

const copy = {
  en: {
    kicker: '',
    heading: 'Get in touch.',
    lede: 'For collaborations, editorial matters at JMP, speaking, prospective PhD students, or master students with an interest in technology and the dark side of organizations.',
    email: 'Email',
    whatsapp: 'WhatsApp',
    cv: 'C.V.',
    findMe: 'Find me',
    tagline: '',
    copyPrefix: `© ${site.shortName} · `,
  },
  he: {
    kicker: '',
    heading: 'צרו קשר.',
    lede: 'לשיתופי פעולה, ענייני עריכה ב-JMP, הרצאות, סטודנטים המעוניינים בלימודי דוקטורט, או תלמידי מחקר בתואר שני עם עניין בטכנולוגיה וצד האפל של ארגונים.',
    email: 'אימייל',
    whatsapp: 'WhatsApp',
    cv: 'קורות חיים',
    findMe: 'מצאו אותי',
    tagline: '',
    copyPrefix: `© ${site.shortName} · `,
  },
}[lang];
---
<footer id="contact" class="bg-accent" style="background-color: var(--color-accent); color: var(--color-bg)">
  <div class="max-w-6xl mx-auto px-6 md:px-10 py-24">
    <div class="grid grid-cols-12 gap-6">
      <div class="col-span-12 md:col-span-8">
        {/* The Associate-Editor credential lives in the homepage's
            "At present" sidebar where it belongs as biographical
            context. It's removed from the Get-in-touch section because
            it has nothing to do with how to reach Yariv. */}
        {copy.kicker && <div class="font-mono text-xs uppercase tracking-widest opacity-60 mb-4">{copy.kicker}</div>}
        <h2 class="font-display font-light leading-none" style="font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 300">
          {copy.heading}
        </h2>
        <p class="mt-6 max-w-md opacity-80">{copy.lede}</p>
        {/* Two real channels for reaching out — kept side-by-side on
            every viewport via flex-nowrap so they read as a single
            two-up affordance instead of stacking on phones. Padding
            tightens on small screens so both still fit comfortably. */}
        <div class="mt-10 flex flex-nowrap gap-3 sm:gap-5">
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center justify-center gap-2 sm:gap-3 px-4 sm:px-7 py-3 sm:py-4 rounded-full text-sm sm:text-base whitespace-nowrap border-2 border-current hover:opacity-80 transition-opacity flex-1 sm:flex-none"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-10 5L2 7"/>
            </svg>
            {copy.email}
          </a>
          <a
            href="https://wa.me/972523975027"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 sm:gap-3 px-4 sm:px-7 py-3 sm:py-4 rounded-full text-sm sm:text-base whitespace-nowrap border-2 border-current hover:opacity-80 transition-opacity flex-1 sm:flex-none"
            aria-label="Send a WhatsApp message"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            {copy.whatsapp}
          </a>
        </div>
      </div>

      {/* vCard QR — right column on desktop, centered below the buttons on
          mobile. Scanning it saves Yariv's contact details. See
          ContactQR.astro for the payload + design rationale. */}
      <div class="col-span-12 md:col-span-4 mt-10 md:mt-0 flex justify-center md:justify-end items-start">
        <ContactQR lang={lang} />
      </div>
    </div>
    <div class="mt-20">
      <div class="flex items-center justify-center flex-wrap gap-x-5 sm:gap-x-6 md:gap-x-8 gap-y-3 mb-6">
        {site.profiles.googleScholar && (
          <a
            href={site.profiles.googleScholar}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest opacity-70 hover:opacity-100 transition-opacity"
            aria-label="Google Scholar profile"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269z"/>
              <path d="M12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
            </svg>
            Scholar
          </a>
        )}
        {site.profiles.orcid && (
          <a
            href={site.profiles.orcid}
            target="_blank"
            rel="noopener noreferrer me"
            class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest opacity-70 hover:opacity-100 transition-opacity"
            aria-label="ORCID profile"
          >
            <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0zm-23.9 57.2c5.2 0 9.4 4.2 9.4 9.4s-4.2 9.4-9.4 9.4-9.4-4.2-9.4-9.4 4.2-9.4 9.4-9.4zm-13 34.9h26.1v92.7H91.1V92.1zm45.7 0h34.2c32.6 0 45.9 23.4 45.9 46.3 0 25.2-17.3 46.3-45.9 46.3h-34.2V92.1zm26.1 20.5v51.7h7.4c18.3 0 21.5-15.5 21.5-25.9 0-11.7-4.4-25.9-21.5-25.9h-7.4z"/>
            </svg>
            ORCID
          </a>
        )}
        {site.profiles.researchGate && (
          <a
            href={site.profiles.researchGate}
            target="_blank"
            rel="noopener noreferrer me"
            class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest opacity-70 hover:opacity-100 transition-opacity"
            aria-label="ResearchGate profile"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6" cy="6" r="2.5"/>
              <circle cx="18" cy="6" r="2.5"/>
              <circle cx="12" cy="18" r="2.5"/>
              <line x1="8.2" y1="6.6" x2="15.8" y2="6.6"/>
              <line x1="7.2" y1="8" x2="11" y2="15.8"/>
              <line x1="16.8" y1="8" x2="13" y2="15.8"/>
            </svg>
            <span class="sm:hidden">RG</span>
            <span class="hidden sm:inline">ResearchGate</span>
          </a>
        )}
        {site.profiles.webOfScience && (
          <a
            href={site.profiles.webOfScience}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest opacity-70 hover:opacity-100 transition-opacity"
            aria-label="Web of Science profile"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <ellipse cx="12" cy="12" rx="4" ry="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
            </svg>
            <span class="sm:hidden">WoS</span>
            <span class="hidden sm:inline">Web of Science</span>
          </a>
        )}
        {/* Live moved into the academic-profile row as another small chip;
            Subscribe and RSS were removed — Subscribe is already a top-nav
            tab, and RSS stays discoverable via the autodiscovery <link> in
            BaseLayout's <head> plus the explainer section on /subscribe. */}
        <a
          href="/live"
          class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-widest opacity-70 hover:opacity-100 transition-opacity"
          aria-label="Live globe of visits and downloads"
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full" style="background: currentColor"></span>
          Live
        </a>
      </div>
      <div class="pt-6 border-t border-current border-opacity-20 text-center font-mono text-xs uppercase tracking-widest opacity-60">
        {copy.copyPrefix}<span data-current-year>{new Date().getFullYear()}</span>
      </div>
      <script is:inline>
        document.querySelectorAll('[data-current-year]').forEach((el) => {
          el.textContent = String(new Date().getFullYear());
        });
      </script>
    </div>
  </div>
</footer>
